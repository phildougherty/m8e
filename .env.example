# Matey (m8e) Environment Variables
#
# Copy this file to .env and fill in your actual values.
# Anything left as `CHANGE_ME` or empty falls back to the matey defaults.
# NEVER commit the .env file to version control.

# ============================================================================
# Core proxy + database (operator-facing)
# ============================================================================

# MCP Proxy API Key. Used by `matey proxy`, `matey serve-proxy`, and any
# client (`matey reload`, the dashboard) that authenticates to the proxy.
# Generate with: openssl rand -hex 32
# In-cluster, prefer Helm value `proxy.apiKeyExistingSecret` over this.
MCP_API_KEY=CHANGE_ME

# Database URL used by the audit backend when M8E_AUDIT_DATABASE_URL is unset.
# Format: postgres://user:pass@host:5432/db?sslmode=disable
DATABASE_URL=

# PostgreSQL password for the bundled MCPPostgres deployment, when used.
# In-cluster, prefer a Secret reference in the MCPPostgres / MCPMemory spec.
POSTGRES_PASSWORD=CHANGE_ME

# ============================================================================
# OAuth (only if you enable the OAuth flow on the proxy)
# ============================================================================

# OAuth client secret consumed by the proxy when OAuth is configured.
OAUTH_CLIENT_SECRET=

# ============================================================================
# Container registry credentials (used by `matey install` / image pulls)
# ============================================================================

# Registry hostname. Defaults to ghcr.io when GitHub fallback vars are set.
MATEY_REGISTRY_URL=ghcr.io

# Registry username and password/token for pulling matey images.
MATEY_REGISTRY_USERNAME=
MATEY_REGISTRY_PASSWORD=

# GitHub-specific fallbacks for MATEY_REGISTRY_USERNAME / MATEY_REGISTRY_PASSWORD.
# Either GITHUB_USERNAME or GITHUB_ACTOR is accepted.
GITHUB_USERNAME=
GITHUB_ACTOR=
GITHUB_TOKEN=

# ============================================================================
# AI provider keys (read by `matey chat`-like flows and the MCP server core)
# ============================================================================

# OpenRouter API key. Get one at https://openrouter.ai/
OPENROUTER_API_KEY=

# OpenAI API key.
OPENAI_API_KEY=

# Anthropic API key (Claude).
ANTHROPIC_API_KEY=

# ============================================================================
# Workflow / task-scheduler runtime
# ============================================================================

# Override the URL the task scheduler uses to reach the proxy when executing
# workflow steps. Defaults to the in-cluster proxy Service.
MCP_PROXY_URL=

# API key the task scheduler presents to the proxy. Defaults to MCP_API_KEY.
MCP_PROXY_API_KEY=

# ============================================================================
# Audit backend (internal/audit/backend.go)
# ============================================================================

# Postgres URL for the audit log. Falls back to DATABASE_URL.
M8E_AUDIT_DATABASE_URL=

# Maximum size (in MB) of an audit log file before rotation.
M8E_AUDIT_MAX_FILE_SIZE=

# Maximum number of rotated audit log files to keep.
M8E_AUDIT_MAX_BACKUPS=

# ============================================================================
# Local CLI behaviour (only relevant when running `matey` outside a cluster)
# ============================================================================

# Path to the kubeconfig used by matey CLI commands. Defaults to ~/.kube/config.
KUBECONFIG=

# Override the namespace matey CLI commands act against. Same as `-n` flag.
MATEY_NAMESPACE=

# Override the data directory matey uses for local state.
MATEY_DATA_DIR=

# Active environment name read by config.LoadConfig for env-specific blocks.
MCP_ENV=

# Host working directory exposed to MCP servers that need to resolve paths
# relative to the human's shell (used by internal/mcp/path_resolver.go).
MATEY_HOST_PWD=

# Bash tool policy mode used by the MCP bash tool.
# One of: off | safe | escalated. Default: safe.
MATEY_BASH_MODE=safe

# Extra commands appended to the bash tool allowlist, comma separated.
MATEY_BASH_ALLOWLIST=

# ============================================================================
# Voice features (only when built with `make build-voice`)
# ============================================================================

VOICE_ENABLED=false
TTS_ENDPOINT=

# ============================================================================
# Security notes
# ============================================================================
# 1. NEVER commit this file with secrets to version control.
# 2. Use strong, unique values for every CHANGE_ME placeholder.
# 3. Rotate credentials periodically.
# 4. Restrict API key permissions to the minimum required.
# 5. For Kubernetes installs, prefer Helm values + Secret references over
#    process environment for everything sensitive.

# ============================================================================
# Generation commands
# ============================================================================
# openssl rand -hex 32                       # 256-bit hex key
# head -c 32 /dev/urandom | base64           # 256-bit base64 key
